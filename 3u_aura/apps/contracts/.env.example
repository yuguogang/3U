# Foundry deploy env for BSC testnet (chainId 97)

# Broadcaster
PRIVATE_KEY=0xYourBroadcasterPrivateKey
OWNER=0xOwnerWallet

# Core addresses
USDT_ADDRESS=0xPaymentToken
FINANCE_WALLET=0xFinanceWallet
REFERRAL_SIGNER=0xReferralSignerWallet

# Optional NFT metadata
NFT_NAME="3U AURA Founder NFT"
NFT_SYMBOL="3UAURA"
BASE_URI=""

# Settlement / claim deploy
FOUNDER_NFT_ADDRESS=0xFounderNFT
SETTLEMENT_PUBLISHER=0xSettlementPublisher
ROOT_PUBLISHER=0xRootPublisher
MAX_SUBSIDY_EPOCHS=12

# RPC for forge script
BSC_TESTNET_RPC_URL=https://your-bsc-testnet-rpc
