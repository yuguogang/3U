NODE_ENV=development
PORT=3010
HOST=http://localhost:3010
API_PREFIX=/api

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/3u_aura?schema=public"
DATABASE_USER="postgres"
DATABASE_PASSWORD="password"
DATABASE_NAME="3u_aura"
DATABASE_HOST="localhost"
DATABASE_PORT=5432

# Cache & Queue (Redis)
CACHE_URL="redis://127.0.0.1:6379"
BULL_HOST="127.0.0.1"
BULL_PORT="6379"

# Throttler
THROTTLER_TTL=60
THROTTLER_LIMIT=60
THROTTLER_REDIS="redis://127.0.0.1:6379"

# Auth
AUTH_JWT_SECRET=test-jwt-secret-for-testing-only
AUTH_JWT_SECRET_EXPIRES_SECONDS=604800
AUTH_JWT_REFRESH_SECRET=test-refresh-secret-for-testing-only
AUTH_JWT_REFRESH_SECRET_EXPIRES_SECONDS=2592000

# Instance ID for distributed processing
INSTANCE_ID="test_instance_01"

# Admin
ADMIN_ALLOWLIST_WALLETS="0xAdminWallet1,0xAdminWallet2"

# Promotion / Testnet (chainId 97)
PROMOTION_CLAIM_CHAIN_ID=97
PROMOTION_START_AT="2026-03-11T00:00:00+08:00"
PROMOTION_TIMEZONE="Asia/Shanghai"
PROMOTION_EPOCH_LENGTH_DAYS=7
PROMOTION_TICKET_STREAK_DAYS=7
PROMOTION_MINIMUM_PARTICIPANTS=12
PROMOTION_REFERRAL_SIGNATURE_TTL_SECONDS=900

# Testnet RPC
PROMOTION_RPC_URL="https://your-bsc-testnet-rpc"
PROMOTION_REFERRAL_RPC_URL="https://your-bsc-testnet-rpc"

# Deployed contract / receiver addresses
PROMOTION_CHECKIN_RECEIVER_ADDRESS="0xCheckinReceiver"
PROMOTION_PAYMENT_TOKEN_ADDRESS="0xPaymentToken"
PROMOTION_NFT_SALE_ADDRESS="0xNftSale"
PROMOTION_MERKLE_DISTRIBUTOR_ADDRESS="0xMerkleClaim"
PROMOTION_SETTLEMENT_ADDRESS="0xSettlement"

# Signer
PROMOTION_REFERRAL_SIGNER_PRIVATE_KEY="0xYourReferralSignerPrivateKey"

