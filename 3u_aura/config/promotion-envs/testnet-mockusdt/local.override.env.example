# Copy this file to `local.override.env` on a developer machine when local
# testnet-mockusdt bring-up needs machine-specific values.

# Local Docker Postgres is currently exposed on 5433 instead of the canonical 5432.
DATABASE_PORT=5433

# Local browser apps should call the local server instead of the deployed API host.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3110

# Local server CORS should trust the local dapp and admin dev servers.
CORS_ORIGIN=http://127.0.0.1:3100,http://127.0.0.1:3101
